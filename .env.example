# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci RAHASIA "service_role" (di dashboard baru bernama "secret key", awalan sb_secret_).
# Hanya untuk server ini. JANGAN dimasukkan ke aplikasi Flutter atau repositori.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Token ----
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ---- Login & lupa sandi ----
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
OTP_LENGTH=4
OTP_TTL_MINUTES=5

# ---- Email OTP (SMTP). Contoh Gmail: smtp.gmail.com:587 + "App Password" ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_NAME=Kenali Batikmu

# HANYA UNTUK PENGEMBANGAN LOKAL: tampilkan OTP di respons API (tanpa SMTP).
# Wajib false di produksi, karena membocorkan kode dan status keterdaftaran email.
EXPOSE_OTP_IN_RESPONSE=false

# Hanya perlu bila memakai build Flutter Web. Pisahkan dengan koma.
CORS_ORIGINS=
