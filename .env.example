# Wajib untuk produksi. Buat dengan: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-panjang

# ==============================================================================
# Konfigurasi Database SQLite
# ==============================================================================
# Path ke file database SQLite (default: app/kenali_batikmu.db)
# DATABASE=./app/kenali_batikmu.db

# Penyimpanan & Upload
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=16

# Auth & Sesi
# TOKEN_TTL_HOURS=24
# TOKEN_TTL_REMEMBER_DAYS=30
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15

# CORS (untuk Flutter Web, pisahkan dengan koma)
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Pengisian Data Awal Otomatis (1 = aktif)
# AUTO_SEED=1

# Host & Port Server Backend
# HOST=0.0.0.0
# PORT=8000

# Akun demo app (sekar@batikmu.id / kenalibatikmu@gmail.com). Password publik: set 0 di produksi.
SEED_DEMO_USERS=1
# Tanpa SMTP, kode OTP lupa-sandi dikembalikan di respons API (mode demo). Set 0 di produksi.
ALLOW_DEMO_OTP=1

# Email OTP (opsional). Jika diisi, OTP dikirim lewat SMTP dan mode demo tidak dipakai.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# OTP_TTL_MINUTES=5
